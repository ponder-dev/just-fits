{
  "name": "justfits",
  "productName": "Just Fits",
  "version": "1.0.0",
  "description": "Make a file small enough to send. Compresses video and images to an exact size limit, entirely on your own machine.",
  "author": {
    "name": "PonderDev",
    "url": "https://ponderdev.com"
  },
  "homepage": "https://ponderdev.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponder-dev/just-fits.git"
  },
  "bugs": {
    "url": "https://github.com/ponder-dev/just-fits/issues"
  },
  "license": "GPL-3.0-or-later",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/plan.test.cjs",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "licences": "node scripts/make-licenses.mjs",
    "icon": "node scripts/make-icon.mjs && electron scripts/icons.cjs && ./scripts/make-icns.sh",
    "dist:mac": "npm run licences && electron-builder --mac",
    "dist:win": "npm run licences && electron-builder --win",
    "dist": "npm run licences && electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
